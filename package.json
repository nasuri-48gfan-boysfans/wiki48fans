{
  "name": "wiki48fans",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix backend run dev",
    "dev:full": "concurrently \"npm --prefix frontend run dev\" \"npm --prefix backend run dev\"",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json --noEmit false --outDir dist-server",
    "build:full": "npm run build && npm run build:server",
    "start:api": "node dist-server/index.js",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
