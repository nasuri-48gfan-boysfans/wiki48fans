# Browser-safe Supabase values
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
VITE_API_URL=https://your-railway-service.up.railway.app

# Server-only values: never expose these through VITE_ variables
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-only-secret
DATABASE_URL=postgresql://user:password@host:5432/database
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/database
SHOWROOM_CREDENTIALS=
IDN_CREDENTIALS=
PAYMENT_PROVIDER_SECRET=
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# Railway runtime
NODE_VERSION=22

# Live tracker source adapters (server-side URLs, if configured)
SHOWROOM_TRACKER_URL=
IDN_TRACKER_URL=
LIVE_TRACKER_INTERVAL_MS=60000
TRACKER_TIMEOUT_MS=10000
VIEWER_SNAPSHOT_INTERVAL_MS=60000
# Community member source key. Register at https://www.jkt48connect.my.id/buyapi
JKT48_CONNECT_API_KEY=
# 48pedia Public API key (Bearer). Register at https://48pedia.id/register
JKT48_48PEDIA_API_KEY=
